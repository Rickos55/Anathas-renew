<%- include('partials/header', {title:'Diplomatie', session, unread, currentCountry}) %>
<h1 class="page-title">Diplomatie - Espionnage</h1>
<% if(country.isBlockaded) { %><div class="alert alert-error">🚫 Votre pays subit un blocus économique ! Revenus commerciaux nuls.</div><% } %>
<div class="two-col">
<div class="section-card"><div class="section-header"><span class="section-title">🕵 Mission d'espionnage</span></div><div class="section-body">
<p style="font-size:12px;color:var(--text-dim);margin-bottom:10px">Niveau espionnage : <strong><%= country.techEspionage %></strong> — Succès : <strong><%= (40+country.techEspionage*10) %>%</strong></p>
<form method="POST" action="/diplomacy/spy">
<div class="form-group"><label>Pays cible</label><select name="target_id">
<% countries.forEach(c => { %><option value="<%= c.id %>"><%= c.name %> (<%= c.User ? c.User.username : '?' %>)</option><% }) %>
</select></div>
<div class="form-group"><label>Mission</label><select name="mission_type">
<option value="reveal_stats">🔍 Révéler les stats (200 §)</option>
<option value="steal_money">💰 Voler de l'argent (500 §)</option>
<option value="sabotage_industry">🏭 Saboter l'industrie (800 §)</option>
<option value="sabotage_army">💣 Saboter l'armée (1 000 §)</option>
</select></div>
<button type="submit" class="btn btn-primary">Envoyer l'agent</button>
</form>
<% if(spyMissions.length) { %>
<hr style="margin:12px 0;border:none;border-top:1px solid var(--border)">
<% spyMissions.forEach(m => { %><div class="spy-row <% if(m.status==='success'){ %>spy-success<% }else{ %>spy-fail<% } %>"><%= m.result %></div><% }) %>
<% } %>
</div></div>
<div class="section-card"><div class="section-header"><span class="section-title">🚫 Blocus économique</span></div><div class="section-body">
<form method="POST" id="bform">
<div class="form-group"><label>Pays à bloquer</label><select name="target_id" id="btarget">
<% countries.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
</select></div>
<button type="submit" class="btn btn-danger" onclick="this.closest('form').action='/diplomacy/blockade/'+document.getElementById('btarget').value">Imposer un blocus</button>
</form>
</div></div>
</div>
<div class="section-card" style="margin-top:14px"><div class="section-header"><span class="section-title">🔬 Accords de recherche</span></div><div class="section-body">
<p style="font-size:12px;color:var(--text-dim);margin-bottom:10px">Un accord de recherche mutuel donne +10% de points de recherche aux deux pays.</p>
<form method="POST" action="/diplomacy/research_agreement">
<div style="display:flex;gap:8px;align-items:flex-end">
<div class="form-group" style="flex:1;margin:0"><label>Pays partenaire</label><select name="target_id">
<% countries.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
</select></div>
<button type="submit" class="btn btn-primary">Proposer</button>
</div>
</form>
<% if(typeof researchAgreements !== 'undefined' && researchAgreements.length) { %>
<hr style="margin:10px 0;border:none;border-top:1px solid var(--border)">
<% researchAgreements.forEach(a => { %>
<div class="stat-row">
<span><%= a.partner ? a.partner.name : '?' %></span>
<span class="<%= a.status==='active'?'badge-active':'badge-banned' %>"><%= a.status==='active'?'✅ Actif':'⏳ En attente' %></span>
<% if(a.status==='pending' && a.countryBId === country.id) { %>
<form method="POST" action="/diplomacy/research_agreement/accept/<%= a.id %>" style="display:inline"><button class="btn btn-sm btn-success">Accepter</button></form>
<form method="POST" action="/diplomacy/research_agreement/reject/<%= a.id %>" style="display:inline"><button class="btn btn-sm btn-danger">Refuser</button></form>
<% } %>
</div>
<% }) %>
<% } %>
</div></div>
<%- include('partials/footer') %>