<%- include('partials/header', {title:'Recherche & Technologie', session, unread, currentCountry}) %>
<h1 class="page-title">Recherche &amp; Technologie</h1>

<!-- ALLOCATION -->
<div class="section-card" style="margin-bottom:14px">
<div class="section-header"><span class="section-title">📊 Allocation des points de recherche</span></div>
<div class="section-body">
<p style="font-size:12px;color:var(--text-dim);margin-bottom:10px">
  Répartissez 100% de vos points de recherche entre les domaines. 
  Gain estimé ce tour : <strong style="color:var(--green)">+<%= totalResearchPerTurn %> pts/tour</strong>
</p>
<form method="POST" action="/research/allocate" class="budget-form">
<div class="budget-grid">
<% techInfo.forEach(t => { %>
<div class="budget-item">
  <label><%= {agriculture:'🌾 Agriculture',military:'⚔ Militaire',industry:'🏭 Industrie',health:'🏥 Médecine',espionage:'🕵 Espionnage'}[t.domain] %></label>
  <input type="number" name="alloc_<%= t.domain %>" value="<%= t.alloc %>" min="0" max="100">
  <span class="budget-pct">%</span>
  <small style="font-size:11px;color:var(--green)">+<%= Math.round(totalResearchPerTurn * t.alloc / 100) %> pts/tour</small>
</div>
<% }) %>
</div>
<button type="submit" class="btn btn-primary btn-sm">Valider l'allocation</button>
</form>
</div></div>

<!-- DOMAINES -->
<div class="three-col">
<% techInfo.forEach(t => { %>
<div class="tech-card">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
    <span class="tech-level-badge">Niveau <%= t.level %></span>
    <span style="font-size:12px;color:var(--teal);font-weight:bold"><%= t.alloc %>% alloué</span>
  </div>
  <strong style="font-size:13px"><%= {agriculture:'🌾 Agriculture',military:'⚔ Militaire',industry:'🏭 Industrie',health:'🏥 Médecine',espionage:'🕵 Espionnage'}[t.domain] %></strong>
  <p class="tech-bonus-text" style="margin-top:4px"><%= {
    agriculture: '+'+t.level*15+'% production alimentaire',
    military: '+'+t.level*10+'% puissance militaire',
    industry: '+'+t.level*15+'% revenus industrie',
    health: '+'+t.level*10+'% santé population',
    espionage: '+'+t.level*10+'% succès espionnage'
  }[t.domain] %></p>
  <div class="stat-row" style="margin-top:6px">
    <span class="stat-label">Points accumulés</span>
    <span class="stat-value gold"><%= t.rp %> / <%= t.cost %> pts</span>
  </div>
  <div class="progress-bar"><div class="progress-fill progress-cyan" style="width:<%= t.progress %>%"></div></div>
  <div style="font-size:11px;color:var(--text-dim);margin:4px 0">
    +<%= Math.round(totalResearchPerTurn * t.alloc / 100) %> pts/tour → niveau suivant dans ~<%= t.alloc > 0 ? Math.ceil((t.cost - t.rp) / Math.max(totalResearchPerTurn * t.alloc / 100, 0.1)) : '∞' %> tours
  </div>
  <form method="POST" action="/research/unlock/<%= t.domain %>" style="margin-top:8px">
    <button type="submit" class="btn btn-sm btn-primary <%= t.rp < t.cost ? 'btn-disabled' : '' %>" <%= t.rp < t.cost ? 'disabled' : '' %>>
      <%= t.rp >= t.cost ? '✅ Débloquer niveau '+(t.level+1) : t.progress+'% – '+(t.cost-t.rp).toFixed(1)+' pts manquants' %>
    </button>
  </form>
</div>
<% }) %>
</div>
<%- include('partials/footer') %>