<%- include('partials/header', {title:category.name, session, unread, currentCountry}) %>
<div class="breadcrumb"><a href="/forum">Forum</a> › <%= category.name %></div>
<h1 class="page-title"><%= category.name %></h1>
<% if(!category.isOfficial || ['admin','moderator'].includes(session.role)) { %>
<div class="section-card" style="margin-bottom:14px"><div class="section-header"><span class="section-title">✍️ Nouveau sujet</span></div><div class="section-body">
<form method="POST" action="/forum/new/<%= category.id %>">
<div class="form-group"><label>Titre</label><input type="text" name="title" required maxlength="200"></div>
<div class="form-group"><label>Message</label><textarea name="content" required rows="4"></textarea></div>
<button type="submit" class="btn btn-primary">Publier</button>
</form></div></div>
<% } %>
<% topics.forEach(t => { %>
<a href="/forum/topic/<%= t.id %>" class="forum-topic-row">
<div class="topic-icons"><% if(t.isPinned) { %>📌<% } %><% if(t.isLocked) { %>🔒<% } %></div>
<div><div class="forum-topic-title"><%= t.title %></div>
<div class="forum-topic-meta">Par <%= t.author ? t.author.username : '?' %> · <%= t.postCount %> réponse(s)</div>
</div></a>
<% }) %>
<% if(!topics.length) { %><p style="color:var(--text-dim)">Aucun sujet.</p><% } %>
<%- include('partials/footer') %>