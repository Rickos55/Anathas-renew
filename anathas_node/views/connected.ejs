<%- include('partials/header', {title:'Joueurs connectés', session, unread, currentCountry}) %>
<h1 class="page-title">Joueurs & Nations</h1>
<div class="section-card"><div class="section-body" style="padding:0">
<table class="data-table">
<thead><tr><th>Joueur</th><th>Pays</th><th>Rôle</th><th>Score</th><th>Population</th><th>Inscrit le</th></tr></thead>
<tbody>
<% users.forEach(u => { %>
<tr class="<%= u.id === session.userId ? 'my-row' : '' %>">
<td><strong><%= u.username %></strong><% if(u.isBanned) { %> <span class="badge-banned">(banni)</span><% } %></td>
<td class="country-name-cell"><%= u.Country ? u.Country.name : '—' %></td>
<td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
<td style="color:var(--teal);font-weight:bold"><%= u.Country ? Math.round(u.Country.score) : 0 %></td>
<td><%= u.Country ? u.Country.population.toLocaleString('fr-FR') : '—' %></td>
<td style="font-size:12px;color:var(--text-dim)"><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
</tr>
<% }) %>
</tbody>
</table>
</div></div>
<%- include('partials/footer') %>