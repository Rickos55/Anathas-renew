<%- include('partials/header', {title:'Territoire', session, unread, currentCountry}) %>
<h1 class="page-title">Territoire et Environnement</h1>
<div class="two-col">
<div class="section-card"><div class="section-header"><span class="section-title">🗺 Régions</span></div><div class="section-body">
<p style="font-weight:bold;margin-bottom:12px">Superficie totale : <%= country.plains+country.desert+country.urban %> régions</p>
<% [['🏜️','Deserts',country.desert,'irrigate','Irriguer (300 §)'],['🌳','Forets',country.forests+' km²','reforest','Reboiser désert (200 §)'],['🏙️','Zones urbaines',country.urban,'urbanize','Urbaniser plaine (500 §)'],['🌾','Plaines',country.plains,'deforest','Défricher forêt (100 §)']].forEach(([icon,name,val,action,label]) => { %>
<div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:12px">
<span style="font-size:28px"><%= icon %></span>
<div><strong><%= name %></strong> : <%= val %><br>
<form method="POST" action="/territory/action" style="margin-top:5px">
<input type="hidden" name="action" value="<%= action %>">
<button class="btn btn-sm btn-cyan"><%= label %></button>
</form></div></div>
<% }) %>
</div></div>
<div>
<div class="section-card"><div class="section-header"><span class="section-title">🌡 Pollution &amp; CC</span></div><div class="section-body">
<div class="stat-row"><span class="stat-label">Pollution</span><span class="stat-value <%= country.pollution<=30?'good':country.pollution<=60?'gold':'bad' %>"><%= country.pollution.toFixed(2) %></span></div>
<div class="progress-bar"><div class="progress-fill <%= country.pollution<=30?'progress-green':country.pollution<=60?'progress-gold':'progress-red' %>" style="width:<%= Math.min(country.pollution,100) %>%"></div></div>
<div class="stat-row"><span class="stat-label">Forêts</span><span class="stat-value"><%= country.forests %> km²</span></div>
<div class="stat-row"><span class="stat-label">Crédits carbone</span><span class="stat-value teal"><%= country.carbonCredits %> CC</span></div>
<p style="font-size:12px;color:var(--text-dim);margin-top:8px">Les CC peuvent être échangés sur le <a href="/market">marché</a>.</p>
</div></div>
</div></div>
<%- include('partials/footer') %>