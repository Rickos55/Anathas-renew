<%- include('partials/header', {title:'Forum', session, unread, currentCountry}) %>
<h1 class="page-title">Forum</h1>
<% categories.forEach(cat => { %>
<a href="/forum/category/<%= cat.id %>" class="forum-cat-row">
<span class="forum-cat-icon"><%= cat.isOfficial?'📢':'💬' %></span>
<div><div class="forum-cat-name"><%= cat.name %><% if(cat.isOfficial) { %> <span class="badge-official">Officiel</span><% } %></div>
<div class="forum-cat-desc"><%= cat.description %> — <%= cat.topicCount %> sujet(s)</div>
</div></a>
<% }) %>
<% if(!categories.length) { %><p style="color:var(--text-dim)">Aucune catégorie. Un admin doit en créer.</p><% } %>
<%- include('partials/footer') %>