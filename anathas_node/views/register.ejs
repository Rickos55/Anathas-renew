<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Inscription — Anathas</title><link rel="stylesheet" href="/css/style.css"><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7302486476390124" crossorigin="anonymous"></script></head><body>
<div class="auth-page">
<div class="auth-logo">ANATHAS</div>
<div class="auth-tagline">Rejoignez la communauté et fondez votre nation</div>
<div class="auth-card">
<h2>🌍 Fonder un pays</h2>
<% if(error && error.length) { %><div class="alert alert-error"><%= error %></div><% } %>
<form method="POST" action="/register">
<div class="form-group"><label>Nom d'utilisateur</label><input type="text" name="username" required autofocus placeholder="Votre pseudonyme"></div>
<div class="form-group"><label>Email</label><input type="email" name="email" required placeholder="votre@email.com"></div>
<div class="form-group"><label>Mot de passe</label><input type="password" name="password" required placeholder="Minimum 6 caractères"></div>
<div class="form-group"><label>Nom de votre pays</label><input type="text" name="country_name" required placeholder="Ex: République d'Arkenfall"></div>
<div class="form-group" style="flex-direction:row;align-items:center;gap:8px;display:flex">
<input type="checkbox" name="accept_cgu" required style="width:auto">
<label style="margin:0;font-weight:normal">J'accepte les <a href="/cgu" target="_blank">conditions d'utilisation</a></label>
</div>
<button type="submit" class="btn btn-primary btn-full" style="margin-top:8px">Fonder mon pays</button>
</form>
<div class="auth-switch">Déjà un compte ? <a href="/login">Se connecter</a></div>
</div></div>
<footer class="site-footer">Anathas — Jeu par navigateur gratuit</footer>
</body></html>
