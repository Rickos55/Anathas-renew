<%- include('partials/header', {title:'Alliances', session, unread, currentCountry}) %>
<h1 class="page-title">Alliances</h1>
<% if(!country.allianceId) { %>
<div class="section-card" style="max-width:450px;margin-bottom:14px"><div class="section-header"><span class="section-title">⚔ Fonder une alliance</span></div><div class="section-body">
<form method="POST" action="/alliances/create">
<div class="form-group"><label>Nom</label><input type="text" name="name" required></div>
<div class="form-group"><label>Description</label><textarea name="description" rows="2"></textarea></div>
<button type="submit" class="btn btn-primary">Fonder</button>
</form></div></div>
<% } else { %>
<div class="alert alert-info">Vous êtes membre d'une alliance. <form method="POST" action="/alliances/leave" style="display:inline"><button class="btn btn-sm btn-danger" onclick="return confirm('Quitter ?')">Quitter</button></form></div>
<% } %>
<% alliances.forEach(a => { %>
<div class="alliance-card">
<h3>🛡 <%= a.name %> <span style="font-size:12px;color:var(--text-dim)">(<%= a.members ? a.members.length : 0 %> membres)</span></h3>
<% if(a.description) { %><p style="font-size:13px;color:var(--text-dim);margin-bottom:8px"><%= a.description %></p><% } %>
<div style="margin-bottom:8px"><% if(a.members) a.members.forEach(m => { %><span class="member-tag"><%= m.name %></span><% }) %></div>
<% if(!country.allianceId) { %>
<form method="POST" action="/alliances/join/<%= a.id %>"><button class="btn btn-sm btn-primary">Rejoindre</button></form>
<% } %>
</div>
<% }) %>
<%- include('partials/footer') %>