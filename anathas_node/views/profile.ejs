<%- include('partials/header', {title:'Mon Profil', session, unread, currentCountry}) %>
<h1 class="page-title">Mon Profil</h1>
<div class="two-col">
<div class="section-card"><div class="section-header"><span class="section-title">👤 Informations</span></div><div class="section-body">
<div class="stat-row"><span class="stat-label">Nom d'utilisateur</span><span class="stat-value teal"><%= user.username %></span></div>
<div class="stat-row"><span class="stat-label">Email</span><span class="stat-value"><%= user.email %></span></div>
<div class="stat-row"><span class="stat-label">Rôle</span><span class="stat-value"><span class="badge badge-<%= user.role %>"><%= user.role %></span></span></div>
<div class="stat-row"><span class="stat-label">Pays</span><span class="stat-value"><%= country ? country.name : '—' %></span></div>
<div class="stat-row"><span class="stat-label">Inscrit le</span><span class="stat-value"><%= new Date(user.createdAt).toLocaleDateString('fr-FR') %></span></div>
</div></div>

<div class="section-card"><div class="section-header"><span class="section-title">✏️ Modifier mon profil</span></div><div class="section-body">
<form method="POST" action="/profile/update">
<div class="form-group"><label>Nouvel email</label><input type="email" name="email" value="<%= user.email %>"></div>
<hr style="margin:12px 0;border:none;border-top:1px solid var(--border)">
<p style="font-size:12px;color:var(--text-dim);margin-bottom:8px">Changer le mot de passe (laisser vide pour ne pas changer)</p>
<div class="form-group"><label>Mot de passe actuel</label><input type="password" name="password" placeholder="Votre mot de passe actuel"></div>
<div class="form-group"><label>Nouveau mot de passe</label><input type="password" name="new_password" placeholder="Minimum 6 caractères"></div>
<button type="submit" class="btn btn-primary">Sauvegarder</button>
</form>
</div></div>
</div>

<% if(country) { %>
<div class="section-card" style="margin-top:14px"><div class="section-header"><span class="section-title">🏳 Mon Pays — <%= country.name %></span></div><div class="section-body">
<div class="three-col">
<div>
<div class="stat-row"><span class="stat-label">Population</span><span class="stat-value"><%= country.population.toLocaleString('fr-FR') %></span></div>
<div class="stat-row"><span class="stat-label">Argent</span><span class="stat-value teal"><%= (country.money/1e9).toFixed(3) %> G$</span></div>
<div class="stat-row"><span class="stat-label">Score</span><span class="stat-value teal"><%= Math.round(country.score) %></span></div>
</div>
<div>
<div class="stat-row"><span class="stat-label">Territoire</span><span class="stat-value"><%= country.plains+country.desert+country.urban %> régions</span></div>
<div class="stat-row"><span class="stat-label">Puissance mil.</span><span class="stat-value"><%= Math.round(country.militaryPower) %></span></div>
<div class="stat-row"><span class="stat-label">Satisfaction</span><span class="stat-value"><%= country.satisfaction.toFixed(1) %>%</span></div>
</div>
<div>
<div class="stat-row"><span class="stat-label">Tech agri.</span><span class="stat-value">Niv. <%= country.techAgriculture %></span></div>
<div class="stat-row"><span class="stat-label">Tech mil.</span><span class="stat-value">Niv. <%= country.techMilitary %></span></div>
<div class="stat-row"><span class="stat-label">Tech ind.</span><span class="stat-value">Niv. <%= country.techIndustry %></span></div>
</div>
</div>
</div></div>
<% } %>
<%- include('partials/footer') %>