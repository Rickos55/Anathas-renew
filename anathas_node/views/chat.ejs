<%- include('partials/header', {title:'Shoutbox', session, unread, currentCountry}) %>
<h1 class="page-title">Shoutbox</h1>
<div class="chat-layout">
<div class="chat-sidebar">
<p style="font-size:12px;font-weight:bold;color:var(--text-dim);margin-bottom:8px">CANAUX</p>
<button class="channel-btn active" data-channel="general" data-aid="">💬 Général</button>
<% if(alliance) { %><button class="channel-btn" data-channel="alliance" data-aid="<%= alliance.id %>">🛡 <%= alliance.name %></button><% } %>
</div>
<div class="chat-main">
<div class="section-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden">
<div class="section-header"><span class="section-title" id="chat-label">💬 Chat Général</span></div>
<div class="chat-messages" id="chat-messages" style="flex:1;border:none;border-radius:0"><p style="color:var(--text-dim)">Chargement...</p></div>
<div style="padding:10px;border-top:1px solid var(--border)">
<div class="chat-input-row"><input type="text" id="chat-input" placeholder="Votre message..." maxlength="500"><button id="chat-send" class="btn btn-primary">Envoyer</button></div>
</div></div></div></div>
<script>
let ch='general',aid=null,last=0;
async function load(){
let url='/api/chat/messages?channel='+ch;if(aid)url+='&alliance_id='+aid;
const r=await fetch(url);const msgs=await r.json();
if(msgs.length===last)return;last=msgs.length;
const c=document.getElementById('chat-messages');
const atBot=c.scrollHeight-c.scrollTop<=c.clientHeight+50;
c.innerHTML=msgs.map(m=>`<div class="chat-msg"><span class="chat-time">${m.time}</span><span class="chat-author role-${m.role}">${m.username}</span><span class="chat-text">${m.content.replace(/</g,'&lt;')}</span></div>`).join('');
if(atBot)c.scrollTop=c.scrollHeight;
}
async function send(){const i=document.getElementById('chat-input');const v=i.value.trim();if(!v)return;
await fetch('/api/chat/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({content:v,channel:ch,alliance_id:aid})});
i.value='';last=0;await load();}
document.getElementById('chat-send').onclick=send;
document.getElementById('chat-input').onkeydown=e=>{if(e.key==='Enter')send();};
document.querySelectorAll('.channel-btn').forEach(b=>{b.onclick=()=>{document.querySelectorAll('.channel-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');ch=b.dataset.channel;aid=b.dataset.aid||null;document.getElementById('chat-label').textContent=ch==='alliance'?'🛡 Alliance':'💬 Général';last=0;load();};});
load();setInterval(load,5000);
</script>
<%- include('partials/footer') %>