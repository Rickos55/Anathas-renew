<%- include('partials/header', {title:'Notifications', session, unread:0, currentCountry}) %>
<h1 class="page-title">Notifications</h1>
<% if(notifs.length) { notifs.forEach(n => { %>
<div class="notif-row <%= !n.isRead?'unread':'' %>">
<span class="notif-icon"><%= n.type==='war'?'⚔️':n.type==='spy'?'🕵️':n.type==='research'?'🔬':n.type==='diplomacy'?'🤝':'ℹ️' %></span>
<span class="notif-text"><%= n.content %></span>
<span class="notif-time"><%= new Date(n.createdAt).toLocaleString('fr-FR') %></span>
</div>
<% }) } else { %><p style="color:var(--text-dim)">Aucune notification.</p><% } %>
<%- include('partials/footer') %>