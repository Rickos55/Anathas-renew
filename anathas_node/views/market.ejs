<%- include('partials/header', {title:"Marchés", session, unread, currentCountry}) %>
<h1 class="page-title">Marchés &amp; Échanges</h1>
<div class="section-card" style="margin-bottom:14px;background:var(--bg-section)">
<div class="section-body" style="display:flex;gap:24px;flex-wrap:wrap;align-items:center">
<div style="font-size:12px;color:var(--text-dim);font-weight:bold">📈 PRIX SPOT :</div>
<div class="stat-row" style="margin:0"><span class="stat-label">🌱 Crédit Carbone</span><span class="stat-value gold" style="margin-left:8px"><%= spotPrices.carbonCredits.toLocaleString('fr-FR') %> §/CC</span></div>
<div class="stat-row" style="margin:0"><span class="stat-label">🔬 Point de Recherche</span><span class="stat-value gold" style="margin-left:8px"><%= spotPrices.researchPoints.toLocaleString('fr-FR') %> §/pt</span></div>
<small style="color:var(--text-dim);font-size:11px">Prix basés sur les dernières transactions du marché</small>
</div></div>
<div class="two-col" style="margin-bottom:14px">
<div class="section-card"><div class="section-header"><span class="section-title">📤 Proposer un échange</span></div><div class="section-body">
<p style="font-size:12px;color:var(--text-dim);margin-bottom:10px">Argent: <%= (country.money/1e9).toFixed(3) %> G$ · CC: <%= country.carbonCredits %> · PRech: <%= Math.round(country.researchPoints) %> · Territoire: <%= country.plains+country.desert+country.urban %> km²</p>
<form method="POST" action="/market/create">
<div class="two-col">
<div><div class="form-group"><label>Je donne</label><select name="give_type">
<% Object.entries(labels).forEach(([k,v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
</select></div>
<div class="form-group"><label>Quantité</label><input type="number" name="give_amount" min="1" value="100" required></div></div>
<div><div class="form-group"><label>Je veux</label><select name="want_type">
<% Object.entries(labels).forEach(([k,v]) => { %><option value="<%= k %>" <%= k==='carbonCredits'?'selected':'' %>><%= v %></option><% }) %>
</select></div>
<div class="form-group"><label>Quantité</label><input type="number" name="want_amount" min="1" value="5" required></div></div>
</div>
<button type="submit" class="btn btn-primary">Publier l'offre</button>
</form>
</div></div>
<div class="section-card"><div class="section-header"><span class="section-title">📋 Mes offres</span></div><div class="section-body">
<% if(myOffers.length) { myOffers.forEach(o => { %>
<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f0f0f0;font-size:13px">
<span><span class="offer-give"><%= o.giveAmount %> <%= labels[o.giveType] %></span> → <span class="offer-get"><%= o.wantAmount %> <%= labels[o.wantType] %></span></span>
<span><% if(o.status==='open') { %><span class="badge-available">Ouverte</span>
<form method="POST" action="/market/cancel/<%= o.id %>" style="display:inline"><button class="btn btn-sm btn-danger">✕</button></form>
<% } else if(o.status==='accepted') { %><span style="color:var(--green)">✅</span><% } else { %><span style="color:var(--text-dim)">Annulée</span><% } %></span>
</div>
<% }) } else { %><p style="color:var(--text-dim);font-size:13px">Aucune offre.</p><% } %>
</div></div>
</div>
<div class="section-card"><div class="section-header"><span class="section-title">🏪 Offres disponibles</span></div><div class="section-body">
<% const available = offers.filter(o => o.sellerId !== country.id); %>
<% if(available.length) { %>
<table class="data-table"><thead><tr><th>Vendeur</th><th>Donne</th><th></th><th>Veut</th><th>Action</th></tr></thead><tbody>
<% available.forEach(o => { %><tr>
<td><%= o.sellerCountry ? o.sellerCountry.name : '?' %></td>
<td class="offer-give"><%= o.giveAmount %> <%= labels[o.giveType] %></td>
<td style="text-align:center">→</td>
<td class="offer-get"><%= o.wantAmount %> <%= labels[o.wantType] %></td>
<td><form method="POST" action="/market/accept/<%= o.id %>"><button class="btn btn-sm btn-success" onclick="return confirm('Accepter cet échange ?')">Accepter</button></form></td>
</tr><% }) %>
</tbody></table>
<% } else { %><p style="color:var(--text-dim);font-size:13px">Aucune offre disponible.</p><% } %>
</div></div>
<%- include('partials/footer') %>