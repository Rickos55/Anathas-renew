<%- include('partials/header', {title:'Finances publiques', session, unread, currentCountry}) %>
<h1 class="page-title">💼 Finances Publiques de <%= country.name %></h1>

<div class="two-col">
<div>
<div class="section-card"><div class="section-header"><span class="section-title">📈 Recettes de l'État</span></div><div class="section-body">
<div class="stat-row"><span class="stat-label">🌾 Agriculture</span><span class="stat-value good">+<%= projections.agriIncome.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">🏭 Industrie</span><span class="stat-value good">+<%= projections.industryIncome.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">🛒 Commerce</span><span class="stat-value <%= country.isBlockaded?'bad':'good' %>"><%= country.isBlockaded?'0 (bloqué)':'+'+projections.commerceIncome.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">💰 Taxe population</span><span class="stat-value good">+<%= projections.popTax.toLocaleString('fr-FR') %> §/tour</span></div>
<hr style="margin:8px 0;border:none;border-top:2px solid var(--border)">
<div class="stat-row"><span class="stat-label" style="font-weight:bold">Total recettes</span><span class="stat-value teal" style="font-size:15px;font-weight:bold">+<%= projections.income.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label" style="color:var(--text-dim)">Annualisé (PIB)</span><span class="stat-value teal"><%= country.gdp ? (country.gdp/1e9).toFixed(3) : '—' %> G$/an</span></div>
</div></div>

<div class="section-card" style="margin-top:14px"><div class="section-header"><span class="section-title">📉 Dépenses de l'État</span></div><div class="section-body">
<% const total = country.budgetAgriculture+country.budgetIndustry+country.budgetHealth+country.budgetMilitary+country.budgetResearch||100;
   const agriSpend = Math.round(projections.income * country.budgetAgriculture / total);
   const indSpend = Math.round(projections.income * country.budgetIndustry / total);
   const healthSpend = Math.round(projections.income * country.budgetHealth / total);
   const milSpend = projections.militaryCost;
   const resSpend = Math.round(projections.income * country.budgetResearch / total);
%>
<div class="stat-row"><span class="stat-label">🌾 Investissement Agriculture</span><span class="stat-value bad">-<%= agriSpend.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">🏭 Investissement Industrie</span><span class="stat-value bad">-<%= indSpend.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">🏥 Santé publique</span><span class="stat-value bad">-<%= healthSpend.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">⚔ Entretien militaire</span><span class="stat-value bad">-<%= milSpend.toLocaleString('fr-FR') %> §/tour</span></div>
<div class="stat-row"><span class="stat-label">🔬 Recherche &amp; Développement</span><span class="stat-value bad">-<%= resSpend.toLocaleString('fr-FR') %> §/tour</span></div>
<hr style="margin:8px 0;border:none;border-top:2px solid var(--border)">
<div class="stat-row"><span class="stat-label" style="font-weight:bold">Total dépenses</span><span class="stat-value bad" style="font-size:15px;font-weight:bold">-<%= (agriSpend+indSpend+healthSpend+milSpend+resSpend).toLocaleString('fr-FR') %> §/tour</span></div>
</div></div>
</div>

<div>
<div class="section-card"><div class="section-header"><span class="section-title">⚖ Bilan budgétaire</span></div><div class="section-body">
<div class="stat-row"><span class="stat-label">Recettes</span><span class="stat-value good">+<%= projections.income.toLocaleString('fr-FR') %> §</span></div>
<div class="stat-row"><span class="stat-label">Dépenses</span><span class="stat-value bad">-<%= projections.militaryCost.toLocaleString('fr-FR') %> § (militaire)</span></div>
<div class="stat-row" style="border-top:2px solid var(--border);padding-top:6px;margin-top:4px">
<span class="stat-label" style="font-weight:bold">Solde par tour</span>
<span class="stat-value <%= projections.moneyDelta>=0?'good':'bad' %>" style="font-size:18px;font-weight:bold">
<%= projections.moneyDelta>=0?'+':'' %><%= projections.moneyDelta.toLocaleString('fr-FR') %> §
</span></div>
<hr style="margin:12px 0;border:none;border-top:1px solid var(--border)">
<div class="stat-row"><span class="stat-label">Trésorerie actuelle</span><span class="stat-value teal"><%= country.money.toLocaleString('fr-FR') %> §</span></div>
<div class="stat-row"><span class="stat-label">Soit en G$</span><span class="stat-value teal"><%= (country.money/1e9).toFixed(3) %> G$</span></div>
<% if(projections.moneyDelta < 0) { %>
<div class="alert alert-warn" style="margin-top:10px">⚠️ Votre bilan est négatif ! Réduisez vos dépenses militaires ou augmentez vos revenus.</div>
<% } else { %>
<div class="alert alert-success" style="margin-top:10px">✅ Votre budget est excédentaire. Vos réserves augmentent.</div>
<% } %>
</div></div>

<div class="section-card" style="margin-top:14px"><div class="section-header"><span class="section-title">📊 Indicateurs clés</span></div><div class="section-body">
<div class="stat-row"><span class="stat-label">PIB annuel</span><span class="stat-value teal"><%= country.gdp ? (country.gdp/1e9).toFixed(3)+' G$' : '—' %></span></div>
<div class="stat-row"><span class="stat-label">PIB par habitant</span><span class="stat-value"><%= country.gdp ? Math.round(country.gdp/country.population).toLocaleString('fr-FR')+' §' : '—' %></span></div>
<div class="stat-row"><span class="stat-label">Charge militaire</span><span class="stat-value <%= projections.militaryCost/projections.income>0.3?'bad':'good' %>"><%= Math.round(projections.militaryCost/Math.max(projections.income,1)*100) %>% des recettes</span></div>
<div class="stat-row"><span class="stat-label">Taux d'emploi</span><span class="stat-value <%= country.employment>=60?'good':country.employment>=30?'gold':'bad' %>"><%= country.employment.toFixed(1) %>%</span></div>
<div class="stat-row"><span class="stat-label">Satisfaction</span><span class="stat-value <%= country.satisfaction>=60?'good':country.satisfaction>=40?'gold':'bad' %>"><%= country.satisfaction.toFixed(1) %>%</span></div>
</div></div>

<div class="section-card" style="margin-top:14px"><div class="section-header"><span class="section-title">⚖ Lois fiscales actives</span></div><div class="section-body">
<p style="font-size:13px;color:var(--text-dim)">Les lois influencent directement vos recettes et dépenses.</p>
<a href="/laws" class="btn btn-primary btn-sm" style="margin-top:8px">Modifier les lois →</a>
</div></div>
</div>
</div>
<%- include('partials/footer') %>