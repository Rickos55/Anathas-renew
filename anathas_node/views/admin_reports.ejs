<%- include('partials/header', {title:'Signalements', session, unread, currentCountry}) %>
<h1 class="page-title">🚨 Signalements</h1>
<div class="section-card"><div class="section-body" style="padding:0">
<% if(reports.length) { %>
<table class="data-table">
<thead><tr><th>Date</th><th>Signalé par</th><th>Contre</th><th>Raison</th><th>Statut</th><th>Action</th></tr></thead>
<tbody>
<% reports.forEach(r => { %>
<tr class="<%= r.status==='resolved'?'':'my-row' %>">
<td style="font-size:11px"><%= new Date(r.createdAt).toLocaleString('fr-FR') %></td>
<td><%= r.reporter ? r.reporter.username : '?' %></td>
<td><%= r.targetUser ? r.targetUser.username : 'Message' %></td>
<td><%= r.reason %></td>
<td><span class="<%= r.status==='resolved'?'badge-active':'badge-banned' %>"><%= r.status==='resolved'?'Résolu':'En attente' %></span></td>
<td>
<% if(r.status !== 'resolved') { %>
<button class="btn btn-sm btn-success" onclick="fetch('/admin/reports/resolve/'+<%=r.id%>,{method:'POST'}).then(()=>location.reload())">✅ Résoudre</button>
<% if(r.targetUser) { %>
<button class="btn btn-sm btn-danger" onclick="if(confirm('Bannir <%=r.targetUser.username%> ?'))fetch('/admin/ban/'+<%=r.targetUser.id%>,{method:'POST'}).then(()=>location.reload())">🚫 Bannir</button>
<% } %>
<% } %>
</td>
</tr>
<% }) %>
</tbody></table>
<% } else { %><p style="padding:14px;color:var(--text-dim)">Aucun signalement.</p><% } %>
</div></div>
<a href="/admin" class="btn btn-secondary">← Retour admin</a>
<%- include('partials/footer') %>